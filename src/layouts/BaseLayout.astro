---
import "../styles/global.css";
import { siGithub, siX } from "simple-icons";

interface Props {
  title: string;
  description?: string;
  /** Open Graph 类型，文章页传 article。 */
  type?: "website" | "article";
  /** 文章首次发布时间，用于 article 元数据。 */
  publishedTime?: Date;
  /** 文章最后更新时间，用于 article 元数据。 */
  modifiedTime?: Date;
  /** 文章标签，用于 article 元数据。 */
  tags?: string[];
  /** 是否禁止索引，404 等页面使用。 */
  noindex?: boolean;
  /** schema.org 结构化数据，后续注入 JSON-LD。 */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  structuredData,
} = Astro.props;
const siteName = "李俊辉";
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const structuredDataJSON = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
const socialLinks = {
  github: "https://github.com/gotorion",
  x: "https://x.com/sigmoid1969",
  linkedin: "https://www.linkedin.com/in/li-junhui-944178280/",
};
const navSocials = [
  {
    label: "GitHub",
    href: socialLinks.github,
    path: siGithub.path,
  },
  {
    label: "X",
    href: socialLinks.x,
    path: siX.path,
  },
  {
    label: "LinkedIn",
    href: socialLinks.linkedin,
    path: "M5.4 7.8H2.2V21h3.2V7.8ZM3.8 2.4a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM21.8 13.7c0-3.9-2-5.8-4.8-5.8a4.2 4.2 0 0 0-3.8 2.1V7.8H10V21h3.2v-6.5c0-1.7.3-3.4 2.5-3.4 2.1 0 2.1 2 2.1 3.5V21h3.2l.8-7.3Z",
  },
];
const navItems = [
  { href: `${base}/`, label: "首页", exact: true },
  { href: `${base}/blog/`, label: "博客" },
  { href: `${base}/about/`, label: "关于" },
];
// 页脚的构建日期用中文数字，和站内的楷体排版一致。
const cnDigits = ["〇", "一", "二", "三", "四", "五", "六", "七", "八", "九"];
const toCn = (value: number) =>
  value < 10
    ? cnDigits[value]
    : value < 20
      ? `十${value % 10 ? cnDigits[value % 10] : ""}`
      : `${cnDigits[Math.floor(value / 10)]}十${value % 10 ? cnDigits[value % 10] : ""}`;
const builtAt = new Date();
const builtYear = Array.from(String(builtAt.getUTCFullYear()), (digit) =>
  toCn(Number(digit)),
).join("");
const builtDate = `${builtYear}年${toCn(builtAt.getUTCMonth() + 1)}月`;
const currentPath = Astro.url.pathname;
const isActive = (item: { href: string; exact?: boolean }) => {
  if (item.exact) return currentPath === item.href;
  const target = item.href.replace(/\/$/, "");
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f9fafb" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}/favicon-32.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${base}/apple-touch-icon.png`}
    />
    <link
      rel="stylesheet"
      href={`${base}/fonts/tsanger-jinkai/result.css`}
    />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{pageTitle}</title>

    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
    />
    <meta name="author" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      type === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {
      structuredDataJSON && (
        <script type="application/ld+json" set:html={structuredDataJSON} />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-title" href={`${base}/`}>
          李俊辉 <span>lijunhui.me</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <div class="nav-links">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class:list={{ "is-active": isActive(item) }}
                  aria-current={isActive(item) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
          <span class="nav-divider" aria-hidden="true"></span>
          <div class="nav-social" role="group" aria-label="社交媒体">
            {
              navSocials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  aria-label={social.label}
                  title={social.label}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={social.path}></path>
                  </svg>
                </a>
              ))
            }
          </div>
        </nav>
      </div>
    </header>

    <main class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-close">
          <p class="footer-lead">有想法，就写信给我。</p>
          <a class="footer-mail" href="mailto:lijunhui.me@foxmail.com">
            lijunhui.me@foxmail.com
          </a>
        </div>
        <svg
          class="footer-mark"
          viewBox="0 0 64 64"
          aria-hidden="true"
          focusable="false"
        >
          <g>
            <circle cx="8" cy="10" r="2.6" />
            <circle cx="20" cy="10" r="2.6" />
            <circle cx="32" cy="10" r="2.6" />
            <circle cx="44" cy="10" r="2.6" />
            <circle cx="56" cy="10" r="2.6" />
          </g>
          <g>
            <circle cx="20" cy="22" r="2.6" />
            <circle cx="32" cy="22" r="2.6" />
            <circle cx="44" cy="22" r="2.6" />
          </g>
          <g>
            <circle cx="32" cy="32" r="2.6" />
          </g>
          <g>
            <circle cx="20" cy="42" r="2.6" />
            <circle cx="32" cy="42" r="2.6" />
            <circle cx="44" cy="42" r="2.6" />
          </g>
          <g>
            <circle cx="8" cy="54" r="2.6" />
            <circle cx="20" cy="54" r="2.6" />
            <circle cx="32" cy="54" r="2.6" />
            <circle cx="44" cy="54" r="2.6" />
            <circle cx="56" cy="54" r="2.6" />
          </g>
        </svg>
      </div>
      <div class="container footer-meta">
        <p>© {builtDate.split("年")[0]} lijunhui.me</p>
        <p>构建于 {builtDate} · Astro + Cloudflare Pages</p>
      </div>
    </footer>

    <script>
      // Chrome 不播放 SVG favicon 内的动画，这里逐帧替换图标来「漏沙」。
      const rows = [
        { y: 14, xs: [12, 22, 32, 42, 52] },
        { y: 23, xs: [22, 32, 42] },
        { y: 32, xs: [32] },
        { y: 41, xs: [22, 32, 42] },
        { y: 50, xs: [12, 22, 32, 42, 52] },
      ];
      // 每一行在每一帧的不透明度：上斗逐行漏空，下斗逐行积起。
      const frames = [
        [1, 1, 1, 0.18, 0.18],
        [0.18, 1, 1, 0.18, 1],
        [0.18, 0.18, 1, 1, 1],
        [0.18, 0.18, 0.18, 1, 1],
      ];
      const icon = document.querySelector<HTMLLinkElement>(
        'link[rel="icon"][type="image/svg+xml"]',
      );

      if (icon) {
        const render = (opacities: number[]) => {
          const groups = rows
            .map((row, index) => {
              const dots = row.xs
                .map((x) => `<circle cx="${x}" cy="${row.y}" r="3.5"/>`)
                .join("");
              return `<g opacity="${opacities[index] ?? 1}">${dots}</g>`;
            })
            .join("");
          const svg =
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">' +
            '<rect width="64" height="64" rx="12" fill="#1b365d"/>' +
            `<g fill="#faf9f5">${groups}</g></svg>`;
          icon.setAttribute(
            "href",
            `data:image/svg+xml,${encodeURIComponent(svg)}`,
          );
        };

        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        let frame = 0;
        let timer = 0;

        const paint = () => {
          render(frames[frame] ?? frames[0] ?? []);
          frame = (frame + 1) % frames.length;
        };

        const start = () => {
          if (timer || reduced.matches) return;
          paint();
          timer = window.setInterval(paint, 1500);
        };

        const stop = () => {
          window.clearInterval(timer);
          timer = 0;
        };

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) stop();
          else start();
        });
        reduced.addEventListener("change", () => {
          stop();
          if (reduced.matches) render(frames[0] ?? []);
          else start();
        });

        if (reduced.matches) render(frames[0] ?? []);
        else start();
      }
    </script>
  </body>
</html>
