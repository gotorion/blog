---
import "../styles/global.css";
import {
  siGithub,
  siTiktok,
  siWechat,
  siX,
  siXiaohongshu,
} from "simple-icons";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = "Gotorion Blog";
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialLinks = {
  github: "https://github.com/gotorion",
  x: "https://x.com/sigmoid1969",
  linkedin: "https://www.linkedin.com/in/li-junhui-944178280/",
  douyin: "https://www.douyin.com/",
  wechat: "https://mp.weixin.qq.com/",
  xiaohongshu: "https://www.xiaohongshu.com/",
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f4ed" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link
      rel="stylesheet"
      href={`${base}/fonts/tsanger-jinkai/result.css`}
    />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-title" href={`${base}/`}>
          Gotorion <span>Blog</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <div class="nav-links">
            <a href={`${base}/`}>文章</a>
            <a href={`${base}/about/`}>关于</a>
          </div>
          <span class="nav-divider" aria-hidden="true"></span>
          <div class="nav-social" role="group" aria-label="社交媒体">
            <a
              href={socialLinks.github}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="GitHub"
              title="GitHub"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={siGithub.path}></path>
              </svg>
            </a>
            <a
              href={socialLinks.x}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="X"
              title="X"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={siX.path}></path>
              </svg>
            </a>
            <a
              href={socialLinks.linkedin}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="LinkedIn"
              title="LinkedIn"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M5.4 7.8H2.2V21h3.2V7.8ZM3.8 2.4a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM21.8 13.7c0-3.9-2-5.8-4.8-5.8a4.2 4.2 0 0 0-3.8 2.1V7.8H10V21h3.2v-6.5c0-1.7.3-3.4 2.5-3.4 2.1 0 2.1 2 2.1 3.5V21h3.2l.8-7.3Z"
                ></path>
              </svg>
            </a>
            <a
              href={socialLinks.douyin}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="抖音"
              title="抖音（测试链接）"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={siTiktok.path}></path>
              </svg>
            </a>
            <a
              href={socialLinks.wechat}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="微信公众号"
              title="微信公众号（测试链接）"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={siWechat.path}></path>
              </svg>
            </a>
            <a
              href={socialLinks.xiaohongshu}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="小红书"
              title="小红书（测试链接）"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={siXiaohongshu.path}></path>
              </svg>
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-mark">
          <p class="footer-title">Gotorion Blog</p>
          <p class="footer-tagline">记录、思考与持续构建。</p>
        </div>
        <div class="footer-meta">
          <p>© {new Date().getFullYear()} Gotorion</p>
          <p>基于 Astro 构建 · Cloudflare Pages</p>
        </div>
      </div>
    </footer>
  </body>
</html>
