---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  headings = [],
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tocItems = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const showToc = tocItems.length >= 2;

const formatDate = (date: Date) =>
  date
    .toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    })
    .replace(/(\d)(年|月|日)/g, "$1 $2");

const published = formatDate(pubDate);
const updated = updatedDate ? formatDate(updatedDate) : undefined;
---

<BaseLayout title={title} description={description}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="post">
    <header class="post-header">
      <div class="post-kicker">
        <span>文章</span>
        <time datetime={pubDate.toISOString()}>{published}</time>
      </div>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      {
        updated && (
          <p class="post-updated">
            更新于 <time datetime={updatedDate?.toISOString()}>{updated}</time>
          </p>
        )
      }
    </header>

    <div class="post-body">
      {
        showToc && (
          <details class="post-toc-mobile">
            <summary>目录</summary>
            <TableOfContents headings={tocItems} />
          </details>
        )
      }

      <div class="prose">
        <slot />
      </div>

      {
        showToc && (
          <aside class="post-aside">
            <nav class="post-toc" aria-label="文章目录">
              <p class="post-toc-title">目录</p>
              <TableOfContents headings={tocItems} />
            </nav>
          </aside>
        )
      }
    </div>

    <footer class="post-footer">
      <a class="back-link" href={`${base}/blog/`}>← 返回博客</a>
      {
        tags.length > 0 && (
          <ul class="post-tags" aria-label="文章标签">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </footer>
  </article>
</BaseLayout>
