---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
  title: string;
  headings?: MarkdownHeading[];
}

const { title, headings = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tocItems = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const showToc = tocItems.length >= 2;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  inLanguage: "zh-CN",
  url: canonicalURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
  author: { "@type": "Person", name: "李俊辉", url: "https://lijunhui.me/" },
  publisher: { "@type": "Person", name: "李俊辉", url: "https://lijunhui.me/" },
};
---

<BaseLayout
  title={title}
  type="article"
  structuredData={articleSchema}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
    </header>

    <div class="post-body">
      {
        showToc && (
          <details class="post-toc-mobile">
            <summary>目录</summary>
            <TableOfContents headings={tocItems} />
          </details>
        )
      }

      <div class="prose">
        <slot />
      </div>

      {
        showToc && (
          <aside class="post-aside">
            <nav class="post-toc" aria-label="文章目录">
              <p class="post-toc-title">目录</p>
              <TableOfContents headings={tocItems} />
            </nav>
          </aside>
        )
      }
    </div>

    <footer class="post-footer">
      <a class="back-link" href={`${base}/blog/`}>← 返回博客</a>
    </footer>
  </article>
</BaseLayout>
