---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroModel from "../components/HeroModel.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const socialLinks = {
  github: "https://github.com/gotorion",
  x: "https://x.com/sigmoid1969",
  linkedin: "https://www.linkedin.com/in/li-junhui-944178280/",
};
---

<BaseLayout
  title="李俊辉"
  description="李俊辉（Gotorion）的个人主页。写软件，做独立项目，记录过程中的思考。"
>
  <section class="home-hero">
    <div>
      <h1>李俊辉</h1>
      <p class="home-hero-meta">Junhui Li · Gotorion</p>
    </div>
    <div class="home-hero-aside">
      <HeroModel />
      <p class="home-lede">写软件，做独立项目，也在这里记录过程中的思考。</p>
      <div class="home-actions">
        <a class="button-primary" href={`${base}/blog/`}>阅读博客</a>
        <a class="button-quiet" href={`${base}/about/`}>关于我 →</a>
      </div>
    </div>
  </section>

  <figure class="home-quote">
    <blockquote>破山中贼易，<br />破心中贼难。</blockquote>
    <figcaption>王阳明</figcaption>
  </figure>

  <section class="home-section" aria-labelledby="home-about">
    <h2 id="home-about">关于</h2>
    <div class="home-section-body">
      <p>
        我是李俊辉，一名写软件的人。这个网站是我的个人主页，也是我公开写作的地方。
      </p>
      <p>
        我关心软件如何被构建、想法如何变成产品，以及人在其中如何保持清醒。写作对我来说，是一种把问题想清楚的方式，也是一种留下踪迹的方式。
      </p>
      <p><a class="text-link" href={`${base}/about/`}>更多关于我 →</a></p>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-writing">
    <h2 id="home-writing">写作</h2>
    <div class="home-section-body">
      <p>博客里记录三类内容：</p>
      <ul class="topic-list">
        <li class="topic-item">
          <h3>软件构建</h3>
          <p>关于写代码、做产品和工程取舍的笔记。</p>
        </li>
        <li class="topic-item">
          <h3>独立项目</h3>
          <p>从想法到上线，以及中间那些不体面的细节。</p>
        </li>
        <li class="topic-item">
          <h3>公开学习</h3>
          <p>把学到的东西写清楚，也留下还没想明白的问题。</p>
        </li>
      </ul>
      <p class="home-more">
        <a class="text-link" href={`${base}/blog/`}>浏览全部文章 →</a>
      </p>
    </div>
  </section>

  <section class="home-contact" aria-labelledby="home-contact-title">
    <h2 id="home-contact-title">联系</h2>
    <div class="home-section-body">
      <p>如果你想聊聊软件、写作，或只是打个招呼，可以在这些地方找到我。</p>
      <ul class="contact-links">
        <li>
          <a
            href={socialLinks.github}
            target="_blank"
            rel="me noopener noreferrer"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={socialLinks.x} target="_blank" rel="me noopener noreferrer">
            X <span aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a
            href={socialLinks.linkedin}
            target="_blank"
            rel="me noopener noreferrer"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
