---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteURL = new URL(`${base}/`, Astro.site).href;
const posts = (await getCollection("blog", ({ data }) => data.title.length > 0))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "zh-CN"));
const featured = posts.find(({ id }) => id === "why-i-started-blogging-again");
const selectedPosts = posts.filter(({ id }) => id !== featured?.id).slice(0, 3);
const engineeringPost = posts.find(({ id }) => id === "tvm-tirx");
const investingPost = posts.find(({ id }) => id === "my-invest-plan");
const socialLinks = {
  github: "https://github.com/gotorion",
  x: "https://x.com/sigmoid1969",
  linkedin: "https://www.linkedin.com/in/li-junhui-944178280/",
};
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "李俊辉",
    alternateName: "Junhui Li",
    url: siteURL,
    sameAs: [socialLinks.github, socialLinks.x, socialLinks.linkedin],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "李俊辉",
    alternateName: "lijunhui.me",
    url: siteURL,
    inLanguage: "zh-CN",
    publisher: { "@type": "Person", name: "李俊辉", url: siteURL },
  },
];
---

<BaseLayout
  title="李俊辉"
  description="李俊辉（lijunhui.me）的个人主页。写软件，做独立项目，记录过程中的思考。"
  structuredData={structuredData}
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-intro">
      <h1 id="home-title">你好，我是<span>李俊辉</span>。</h1>
      <p class="home-hero-sub">
        我是一名在上海工作的工程师。平时写软件、做独立项目，也在这里记录我对技术、阅读和投资的思考。
      </p>
      <div class="home-actions">
        <a class="button-primary" href="#home-topics">从这里开始</a>
        <a class="button-quiet" href={`${base}/about/`}>关于我</a>
      </div>
    </div>
    {featured && (
      <aside class="home-feature" aria-labelledby="home-feature-title">
        <p>关于这个博客</p>
        <h2 id="home-feature-title">
          <a href={`${base}/blog/${featured.id}/`}>{featured.data.title}</a>
        </h2>
      </aside>
    )}
  </section>

  <section class="home-topics" id="home-topics" aria-labelledby="home-topics-title">
    <h2 id="home-topics-title">从你感兴趣的开始</h2>
    <ul class="home-topic-grid">
      {engineeringPost && (
        <li class="home-topic home-topic-tech">
          <h3>软件与技术</h3>
          <a href={`${base}/blog/${engineeringPost.id}/`}>{engineeringPost.data.title}</a>
        </li>
      )}
      <li class="home-topic home-topic-code">
        <h3>独立项目</h3>
        <a href={socialLinks.github}>浏览 GitHub 仓库</a>
      </li>
      {investingPost && (
        <li class="home-topic home-topic-invest">
          <h3>投资笔记</h3>
          <a href={`${base}/blog/${investingPost.id}/`}>{investingPost.data.title}</a>
        </li>
      )}
    </ul>
  </section>

  {selectedPosts.length > 0 && (
    <section class="home-writing" aria-labelledby="home-writing-title">
      <header class="home-writing-header">
        <h2 id="home-writing-title">文章选读</h2>
        <a href={`${base}/blog/`}>全部文章</a>
      </header>
      <ul class="home-posts">
        {selectedPosts.map(({ id, data }) => (
          <li>
            <article>
              <h3><a href={`${base}/blog/${id}/`}>{data.title}</a></h3>
            </article>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
