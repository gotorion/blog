---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroModel from "../components/HeroModel.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteURL = new URL(`${base}/`, Astro.site).href;
const socialLinks = {
  github: "https://github.com/gotorion",
  x: "https://x.com/sigmoid1969",
  linkedin: "https://www.linkedin.com/in/li-junhui-944178280/",
};
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "李俊辉",
    alternateName: "Junhui Li",
    url: siteURL,
    sameAs: [socialLinks.github, socialLinks.x, socialLinks.linkedin],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "李俊辉",
    alternateName: "lijunhui.me",
    url: siteURL,
    inLanguage: "zh-CN",
    publisher: { "@type": "Person", name: "李俊辉", url: siteURL },
  },
];
---

<BaseLayout
  title="李俊辉"
  description="李俊辉（lijunhui.me）的个人主页。写软件，做独立项目，记录过程中的思考。"
  structuredData={structuredData}
>
  <section class="home-hero">
    <div class="home-hero-main">
      <p class="home-hero-rubric">JUNHUI LI · LIJUNHUI.ME</p>
      <h1>李俊辉</h1>
      <p class="home-hero-sub">
        写软件，做独立项目，也在这里记录过程中的思考。
      </p>
      <dl class="home-hero-meta">
        <dt>写作</dt>
        <dd>软件构建 · 独立项目 · 公开学习</dd>
        <dt>社交</dt>
        <dd>
          <a
            href={socialLinks.github}
            target="_blank"
            rel="me noopener noreferrer">GitHub</a
          >
          <span aria-hidden="true"> · </span>
          <a
            href={socialLinks.x}
            target="_blank"
            rel="me noopener noreferrer">X</a
          >
          <span aria-hidden="true"> · </span>
          <a
            href={socialLinks.linkedin}
            target="_blank"
            rel="me noopener noreferrer">LinkedIn</a
          >
        </dd>
      </dl>
      <div class="home-actions">
        <a class="button-primary" href={`${base}/blog/`}>阅读博客</a>
        <a class="button-quiet" href={`${base}/about/`}>关于我 →</a>
      </div>
    </div>
    <div class="home-hero-aside">
      <HeroModel />
    </div>
  </section>
</BaseLayout>
