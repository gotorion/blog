---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 6);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Gotorion Blog"
  description="记录软件构建、公开学习与独立项目的思考和实践。"
>
  <section class="hero">
    <p class="eyebrow">记录与思考</p>
    <h1>认真构建。<br />分享所学。</h1>
    <p>
      一个关于软件、有趣实验，以及那些让项目值得被留下来的细节的个人博客。
    </p>
  </section>

  <section aria-labelledby="latest-posts">
    <div class="section-heading">
      <h2 id="latest-posts">最新文章</h2>
      <span>共 {posts.length} 篇</span>
    </div>

    {
      latestPosts.length > 0 ? (
        <ul class="post-list">
          {latestPosts.map((post) => (
            <li>
              <article>
                <p class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("zh-CN", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                      timeZone: "UTC",
                    })}
                  </time>
                </p>
                <h3>
                  <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">还没有文章。请在 <code>src/content/blog/</code> 中添加。</p>
      )
    }
  </section>
</BaseLayout>
