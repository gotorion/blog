---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => data.title.length > 0)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title, "zh-CN"),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const blogURL = new URL(`${base}/blog/`, Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "李俊辉的博客",
  description: "记录软件构建、公开学习与独立项目的思考和实践。",
  url: blogURL,
  inLanguage: "zh-CN",
  author: {
    "@type": "Person",
    name: "李俊辉",
    url: new URL(`${base}/`, Astro.site).href,
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(`${base}/blog/${post.id}/`, Astro.site).href,
  })),
};
---

<BaseLayout
  title="博客"
  description="记录软件构建、公开学习与独立项目的思考和实践。"
  structuredData={structuredData}
>
  <section class="blog-index">
    <header class="blog-index-header">
      <h1>博客</h1>
      <p>记录软件构建、公开学习与独立项目的思考和实践。</p>
      <p class="blog-index-count">共 {posts.length} 篇</p>
    </header>

    <div class="blog-index-body">
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <h2><a href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h2>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-state">还没有文章。</p>
        )
      }
    </div>
  </section>
</BaseLayout>
