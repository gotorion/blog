---
import { getCollection } from "astro:content";
import { execFileSync } from "node:child_process";
import { statSync } from "node:fs";
import BaseLayout from "../../layouts/BaseLayout.astro";

// 保留旧文章原有的发布日期；新文章使用首次 Git 提交的日期。
const originalDates: Record<string, string> = {
  "why-i-started-blogging-again": "2026-11-10",
  "my-tools": "2026-11-16",
  "tvm-tirx": "2026-11-18",
  "my-invest-plan": "2026-11-18",
  "4-invest-principles-from-vanguard": "2026-11-20",
  "why-we-still-learn": "2026-11-23",
};

function publicationDay(id: string, filePath: string) {
  if (originalDates[id]) return originalDates[id];
  const history = execFileSync("git", [
    "log", "--follow", "--diff-filter=A", "--format=%aI", "--", filePath,
  ], { encoding: "utf8" }).trim();
  return history.split("\n").at(-1)?.slice(0, 10)
    || statSync(filePath).mtime.toISOString().slice(0, 10);
}

const entries = await getCollection("blog", ({ data }) => data.title.length > 0);
const posts = entries.map((post) => ({
  ...post,
  day: publicationDay(post.id, post.filePath!),
})).sort((a, b) => b.day.localeCompare(a.day) || a.id.localeCompare(b.id));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const blogURL = new URL(`${base}/blog/`, Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "李俊辉的博客",
  description: "记录软件构建、公开学习与独立项目的思考和实践。",
  url: blogURL,
  inLanguage: "zh-CN",
  author: {
    "@type": "Person",
    name: "李俊辉",
    url: new URL(`${base}/`, Astro.site).href,
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(`${base}/blog/${post.id}/`, Astro.site).href,
  })),
};
---

<BaseLayout
  title="博客"
  description="记录软件构建、公开学习与独立项目的思考和实践。"
  structuredData={structuredData}
>
  <section class="blog-index">
    <h1>博客</h1>
    {posts.length ? (
      <ul class="archive-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.day}>{post.day}</time>
            <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    ) : <p class="empty-state">还没有文章。</p>}
  </section>
</BaseLayout>
